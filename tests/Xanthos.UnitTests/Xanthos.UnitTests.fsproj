    <Compile Include="OfficialFoundationTests.fs" />
    <Compile Include="RecordOracle.fs" />
    <Compile Include="AdditionalRecordContractTests.fs" />
    <Compile Include="AdditionalFormatTests.fs" />
    <Compile Include="DataSpecContractTests.fs" />
    <Compile Include="SpecialRegistrationTests.fs" />
    <Compile Include="RaceContractTests.fs" />
    <Compile Include="RunnerContractTests.fs" />
    <Compile Include="PayoffContractTests.fs" />
    <Compile Include="VotesContractTests.fs" />
    <Compile Include="OddsContractTests.fs" />
    <Compile Include="ChangesContractTests.fs" />
    <Compile Include="OwnershipContractTests.fs" />
    <Compile Include="HorseContractTests.fs" />
    <Compile Include="RaceRecordContractTests.fs" />
    <Compile Include="PeopleContractTests.fs" />
    <Compile Include="IdentifierFormatTests.fs" />
    <Compile Include="NativeSessionLifetimeTests.fs" />
    <Compile Include="ComAbnormalTests.fs" />
    <Compile Include="ComContractTests.fs" />
    <Compile Include="ComEventsTests.fs" />
    <Compile Include="PayloadParserApiTests.fs" />
    <Compile Include="ComGetsMappingTests.fs" />
    <Compile Include="DownloadMonitorTests.fs" />
    <Compile Include="ErrorCodesBoundaryTests.fs" />
    <Compile Include="JvLinkServiceDownloadTests.fs" />
    <Compile Include="RecordParserTests.fs" />
    <Compile Include="RecordTypesTests.fs" />
    <Compile Include="StreamRealtimeTests.fs" />
    <Compile Include="StreamPayloadsTests.fs" />
    <Compile Include="SerializationTests.fs" />
    <Compile Include="RecordParserErrorTests.fs" />
    <Compile Include="RecordRelationshipTests.fs" />
    <Compile Include="PropertyTests.fs" />
    <Compile Include="EdgeCaseTests.fs" />
    <Compile Include="IntegrationTests.fs" />
    <Compile Include="ComprehensiveFieldTests.fs" />
    <Compile Include="ExceptionHandlingTests.fs" />
    <Compile Include="JvLinkServiceErrorTests.fs" />
    <Compile Include="RuntimeModuleTests.fs" />
    <Compile Include="CoreModuleTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="LibraryTests.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="WatchEventFromTimeTests.fs" />
    <Compile Include="FixtureParserTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Contracts/sdk-return-codes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Contracts/official-codes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Contracts/record-layouts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Contracts/dataspecs.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Xanthos\Xanthos.fsproj" />
    <ProjectReference Include="..\..\samples\Xanthos.Functional\Xanthos.Functional.fsproj" />
  </ItemGroup>
</Project>
